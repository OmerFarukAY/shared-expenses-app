rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users/{uid}
    // Fields:
    //   - uid: string (must match request.auth.uid)
    //   - displayName: string (1..50 chars)
    //   - preferredCurrency: string (3 chars ISO code)
    //   - languageCode: string (2 chars)
    //   - createdAt: timestamp
    //   - updatedAt: timestamp
    //
    // Collection: groups/{groupId}
    // Fields:
    //   - id: string
    //   - name: string (1..60 chars)
    //   - description: optional string (<= 200 chars)
    //   - defaultCurrency: string (3 chars ISO code)
    //   - inviteCode: string (6..12 chars uppercase alphanumeric)
    //   - createdBy: string (uid)
    //   - createdAt: timestamp
    //   - updatedAt: timestamp
    //   - memberCount: int (>= 1)
    //   - active: bool
    //
    // Collection: groups/{groupId}/members/{uid}
    // Fields:
    //   - uid: string
    //   - displayName: string (1..50 chars)
    //   - role: "owner" | "member"
    //   - joinedAt: timestamp
    //
    // Collection: groups/{groupId}/expenses/{expenseId}
    // Fields:
    //   - id: string
    //   - groupId: string
    //   - title: string (1..100 chars)
    //   - notes: optional string (<= 300 chars)
    //   - category: string
    //   - currency: string (3 chars ISO)
    //   - totalMinor: int (> 0)
    //   - date: timestamp
    //   - splitMethod: "equal" | "custom" | "percentage"
    //   - payers: map (uid -> int minor)
    //   - participants: list of string uids
    //   - splits: map (uid -> int minor)
    //   - createdBy: string (uid)
    //   - createdAt: timestamp
    //   - updatedAt: timestamp
    //
    // Collection: groups/{groupId}/settlements/{settlementId}
    // Fields:
    //   - id: string
    //   - groupId: string
    //   - fromUid: string
    //   - toUid: string
    //   - amountMinor: int (> 0)
    //   - currency: string (3 chars ISO)
    //   - settledAt: timestamp
    //   - createdBy: string (uid)
    //   - notes: optional string (<= 200 chars)
    //
    // Collection: invites/{inviteCode}
    // Fields:
    //   - inviteCode: string
    //   - groupId: string
    //   - groupName: string (1..60 chars)
    //   - defaultCurrency: string (3 chars ISO)
    //   - createdBy: string (uid)
    //   - createdAt: timestamp
    //   - active: bool
    // ===============================================================

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isGroupMember(groupId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))
      );
    }

    function isGroupCreator(groupId) {
      return isAuthenticated() && (
        request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy
      );
    }

    // User document validation
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'preferredCurrency', 'languageCode', 'createdAt', 'updatedAt']) &&
             data.uid is string && data.uid == request.auth.uid &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 50 &&
             data.preferredCurrency is string && data.preferredCurrency.size() == 3 &&
             data.languageCode is string && data.languageCode.size() >= 2 && data.languageCode.size() <= 5 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    // ===============================================================
    // Users Collection
    // ===============================================================
    match /users/{uid} {
      // Direct lookup allowed only for the owning user
      allow get: if isOwner(uid);
      // Listing/enumerating all users is strictly forbidden
      allow list: if false;

      allow create: if isOwner(uid) && isValidUser(request.resource.data);
      allow update: if isOwner(uid) && isValidUser(request.resource.data);
      allow delete: if isOwner(uid);

      match /user_groups/{groupId} {
        allow read, write: if isOwner(uid);
      }
    }

    function isValidCurrency(curr) {
      return curr is string && curr.matches('^[A-Z]{3}$');
    }

    function arePayersValid(groupId, payers, totalMinor) {
      return payers is map && payers.size() >= 1 &&
             (
               (payers.size() == 1 &&
                payers.values()[0] is int && payers.values()[0] > 0 &&
                payers.values()[0] == totalMinor &&
                exists(/databases/$(database)/documents/groups/$(groupId)/members/$(payers.keys()[0]))) ||
               (payers.size() == 2 &&
                payers.values()[0] is int && payers.values()[0] > 0 &&
                payers.values()[1] is int && payers.values()[1] > 0 &&
                payers.values()[0] + payers.values()[1] == totalMinor &&
                exists(/databases/$(database)/documents/groups/$(groupId)/members/$(payers.keys()[0])) &&
                exists(/databases/$(database)/documents/groups/$(groupId)/members/$(payers.keys()[1]))) ||
               (payers.size() == 3 &&
                payers.values()[0] is int && payers.values()[0] > 0 &&
                payers.values()[1] is int && payers.values()[1] > 0 &&
                payers.values()[2] is int && payers.values()[2] > 0 &&
                payers.values()[0] + payers.values()[1] + payers.values()[2] == totalMinor &&
                exists(/databases/$(database)/documents/groups/$(groupId)/members/$(payers.keys()[0])) &&
                exists(/databases/$(database)/documents/groups/$(groupId)/members/$(payers.keys()[1])) &&
                exists(/databases/$(database)/documents/groups/$(groupId)/members/$(payers.keys()[2]))) ||
               (payers.size() >= 4)
             );
    }

    function areSplitsValid(groupId, splits, participants, totalMinor) {
      return splits is map && splits.size() >= 1 &&
             participants is list && participants.size() == splits.size() &&
             participants.hasAll(splits.keys()) &&
             splits.keys().hasAll(participants) &&
             (
               // Check group membership for split participants
               (splits.size() == 1 && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(splits.keys()[0]))) ||
               (splits.size() == 2 && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(splits.keys()[0])) &&
                                      exists(/databases/$(database)/documents/groups/$(groupId)/members/$(splits.keys()[1]))) ||
               (splits.size() >= 3 && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(splits.keys()[0])) &&
                                      exists(/databases/$(database)/documents/groups/$(groupId)/members/$(splits.keys()[1])) &&
                                      exists(/databases/$(database)/documents/groups/$(groupId)/members/$(splits.keys()[2]))) ||
               (splits.size() > 3)
             ) &&
             (
               // Mathematical integer sum integrity check
               (splits.size() == 1 && splits.values()[0] is int && splits.values()[0] > 0 && splits.values()[0] == totalMinor) ||
               (splits.size() == 2 && splits.values()[0] is int && splits.values()[0] > 0 &&
                                      splits.values()[1] is int && splits.values()[1] > 0 &&
                                      splits.values()[0] + splits.values()[1] == totalMinor) ||
               (splits.size() == 3 && splits.values()[0] is int && splits.values()[0] > 0 &&
                                      splits.values()[1] is int && splits.values()[1] > 0 &&
                                      splits.values()[2] is int && splits.values()[2] > 0 &&
                                      splits.values()[0] + splits.values()[1] + splits.values()[2] == totalMinor) ||
               (splits.size() == 4 && splits.values()[0] is int && splits.values()[0] > 0 &&
                                      splits.values()[1] is int && splits.values()[1] > 0 &&
                                      splits.values()[2] is int && splits.values()[2] > 0 &&
                                      splits.values()[3] is int && splits.values()[3] > 0 &&
                                      splits.values()[0] + splits.values()[1] + splits.values()[2] + splits.values()[3] == totalMinor) ||
               (splits.size() == 5 && splits.values()[0] is int && splits.values()[0] > 0 &&
                                      splits.values()[1] is int && splits.values()[1] > 0 &&
                                      splits.values()[2] is int && splits.values()[2] > 0 &&
                                      splits.values()[3] is int && splits.values()[3] > 0 &&
                                      splits.values()[4] is int && splits.values()[4] > 0 &&
                                      splits.values()[0] + splits.values()[1] + splits.values()[2] + splits.values()[3] + splits.values()[4] == totalMinor) ||
               (splits.size() == 6 && splits.values()[0] is int && splits.values()[0] > 0 &&
                                      splits.values()[1] is int && splits.values()[1] > 0 &&
                                      splits.values()[2] is int && splits.values()[2] > 0 &&
                                      splits.values()[3] is int && splits.values()[3] > 0 &&
                                      splits.values()[4] is int && splits.values()[4] > 0 &&
                                      splits.values()[5] is int && splits.values()[5] > 0 &&
                                      splits.values()[0] + splits.values()[1] + splits.values()[2] + splits.values()[3] + splits.values()[4] + splits.values()[5] == totalMinor) ||
               (splits.size() >= 7)
             );
    }

    function isValidExpense(data, groupId) {
      return data.keys().hasAll(['id', 'groupId', 'title', 'category', 'currency', 'totalMinor', 'date', 'splitMethod', 'payers', 'participants', 'splits', 'createdBy', 'createdAt', 'updatedAt']) &&
             data.id is string &&
             data.groupId == groupId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
             data.totalMinor is int && data.totalMinor > 0 &&
             isValidCurrency(data.currency) &&
             arePayersValid(groupId, data.payers, data.totalMinor) &&
             areSplitsValid(groupId, data.splits, data.participants, data.totalMinor);
    }

    // ===============================================================
    // Groups Collection & Subcollections
    // ===============================================================
    match /groups/{groupId} {
      // Listing all groups across the database is forbidden
      allow list: if false;

      // Group details can ONLY be retrieved by active members or the creator.
      // Guessing groupId by non-members is strictly blocked.
      allow get: if isGroupMember(groupId) || (isAuthenticated() && request.auth.uid == resource.data.createdBy);

      // Authenticated users can create groups if they set themselves as creator
      allow create: if isAuthenticated() &&
                       request.resource.data.keys().hasAll(['id', 'name', 'defaultCurrency', 'inviteCode', 'createdBy', 'createdAt', 'updatedAt', 'memberCount', 'active']) &&
                       request.resource.data.id == groupId &&
                       request.resource.data.createdBy == request.auth.uid &&
                       request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 60 &&
                       request.resource.data.defaultCurrency is string && request.resource.data.defaultCurrency.size() == 3 &&
                       request.resource.data.inviteCode is string && request.resource.data.inviteCode.size() >= 6 && request.resource.data.inviteCode.size() <= 12 &&
                       request.resource.data.memberCount is int && request.resource.data.memberCount >= 1 &&
                       request.resource.data.active is bool;

      // Members can update group details, or joining users can update memberCount
      allow update: if isAuthenticated() &&
                       request.resource.data.id == resource.data.id &&
                       request.resource.data.createdBy == resource.data.createdBy &&
                       request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 60 &&
                       (isGroupMember(groupId) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'updatedAt']));

      allow delete: if isAuthenticated() && request.auth.uid == resource.data.createdBy;

      // Subcollection: members
      match /members/{memberUid} {
        // Only active group members can list members (roster)
        allow list: if isGroupMember(groupId);
        // Direct member doc lookup allowed for group members or the member themselves
        allow get: if isGroupMember(groupId) || (isAuthenticated() && request.auth.uid == memberUid);

        // A user can add themselves as a member if creating or joining:
        allow create: if isAuthenticated() && request.auth.uid == memberUid &&
                         request.resource.data.keys().hasAll(['uid', 'displayName', 'role', 'joinedAt']) &&
                         request.resource.data.uid == memberUid &&
                         request.resource.data.displayName is string &&
                         request.resource.data.displayName.size() >= 1 &&
                         request.resource.data.displayName.size() <= 50 &&
                         (
                           // Case 1: Group creator creating group with role 'owner'
                           (request.resource.data.role == 'owner' &&
                            getAfter(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid)
                           ||
                           // Case 2: Joining member with valid active invite code (role strictly 'member')
                           (request.resource.data.role == 'member' &&
                            request.resource.data.keys().hasAll(['inviteCode']) &&
                            request.resource.data.inviteCode is string &&
                            exists(/databases/$(database)/documents/groups/$(groupId)) &&
                            get(/databases/$(database)/documents/groups/$(groupId)).data.active == true &&
                            get(/databases/$(database)/documents/groups/$(groupId)).data.inviteCode == request.resource.data.inviteCode &&
                            exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)) &&
                            get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.active == true &&
                            get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.groupId == groupId)
                         );

        // Users can update their own display name within the group
        allow update: if isAuthenticated() && request.auth.uid == memberUid &&
                         request.resource.data.uid == memberUid &&
                         request.resource.data.role == resource.data.role &&
                         request.resource.data.displayName is string && request.resource.data.displayName.size() >= 1 && request.resource.data.displayName.size() <= 50;

        // User can remove themselves or group creator can remove member
        allow delete: if isAuthenticated() && (request.auth.uid == memberUid || isGroupCreator(groupId));
      }

      // Subcollection: expenses
      match /expenses/{expenseId} {
        // ONLY group members can read or list expenses
        allow get, list: if isGroupMember(groupId);

        // ONLY group members can create expenses in their group
        allow create: if isGroupMember(groupId) &&
                         request.resource.data.id == expenseId &&
                         request.resource.data.createdBy == request.auth.uid &&
                         isValidExpense(request.resource.data, groupId);

        // ONLY group members can update expenses in their group
        allow update: if isGroupMember(groupId) &&
                         request.resource.data.id == resource.data.id &&
                         request.resource.data.groupId == resource.data.groupId &&
                         request.resource.data.createdBy == resource.data.createdBy &&
                         isValidExpense(request.resource.data, groupId);

        // ONLY group members can delete expenses in their group
        allow delete: if isGroupMember(groupId);
      }

      // Subcollection: settlements
      match /settlements/{settlementId} {
        // ONLY group members can read or list settlements
        allow get, list: if isGroupMember(groupId);

        // ONLY group members can record settlements in their group
        allow create: if isGroupMember(groupId) &&
                         request.resource.data.keys().hasAll(['id', 'groupId', 'fromUid', 'toUid', 'amountMinor', 'currency', 'settledAt', 'createdBy']) &&
                         request.resource.data.id == settlementId &&
                         request.resource.data.groupId == groupId &&
                         request.resource.data.createdBy == request.auth.uid &&
                         request.resource.data.fromUid is string &&
                         request.resource.data.toUid is string &&
                         request.resource.data.fromUid != request.resource.data.toUid &&
                         request.resource.data.amountMinor is int && request.resource.data.amountMinor > 0 &&
                         request.resource.data.currency is string && request.resource.data.currency.size() == 3;

        // ONLY group members can delete settlements in their group
        allow delete: if isGroupMember(groupId);
      }
    }

    // ===============================================================
    // Public Invites Collection
    // ===============================================================
    match /invites/{inviteCode} {
      // Direct lookup ONLY for authenticated users with the specific code
      allow get: if isAuthenticated();

      // Collection listing / enumeration strictly forbidden
      allow list: if false;

      // Only group members or creator can publish an invite
      allow create: if isAuthenticated() &&
                       request.resource.data.keys().hasAll(['inviteCode', 'groupId', 'groupName', 'defaultCurrency', 'createdBy', 'createdAt', 'active']) &&
                       request.resource.data.inviteCode == inviteCode &&
                       request.resource.data.createdBy == request.auth.uid &&
                       request.resource.data.active is bool;

      allow update: if isAuthenticated() &&
                       isGroupMember(resource.data.groupId) &&
                       request.resource.data.groupId == resource.data.groupId;

      allow delete: if isAuthenticated() && isGroupCreator(resource.data.groupId);
    }
  }
}
