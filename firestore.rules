rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users/{uid}
    // Fields:
    //   - uid: string (must match request.auth.uid)
    //   - displayName: string (1..50 chars)
    //   - preferredCurrency: string (3 chars ISO code)
    //   - languageCode: string (2 chars)
    //   - createdAt: timestamp
    //   - updatedAt: timestamp
    //
    // Collection: groups/{groupId}
    // Fields:
    //   - id: string
    //   - name: string (1..60 chars)
    //   - description: optional string (<= 200 chars)
    //   - defaultCurrency: string (3 chars ISO code)
    //   - inviteCode: string (6..12 chars uppercase alphanumeric)
    //   - createdBy: string (uid)
    //   - createdAt: timestamp
    //   - updatedAt: timestamp
    //   - memberCount: int (>= 1)
    //   - active: bool
    //
    // Collection: groups/{groupId}/members/{uid}
    // Fields:
    //   - uid: string
    //   - displayName: string (1..50 chars)
    //   - role: "owner" | "member"
    //   - joinedAt: timestamp
    //
    // Collection: groups/{groupId}/expenses/{expenseId}
    // Fields:
    //   - id: string
    //   - groupId: string
    //   - title: string (1..100 chars)
    //   - notes: optional string (<= 300 chars)
    //   - category: string
    //   - currency: string (3 chars ISO)
    //   - totalMinor: int (> 0)
    //   - date: timestamp
    //   - splitMethod: "equal" | "custom" | "percentage"
    //   - payers: map (uid -> int minor)
    //   - participants: list of string uids
    //   - splits: map (uid -> int minor)
    //   - createdBy: string (uid)
    //   - createdAt: timestamp
    //   - updatedAt: timestamp
    //
    // Collection: groups/{groupId}/settlements/{settlementId}
    // Fields:
    //   - id: string
    //   - groupId: string
    //   - fromUid: string
    //   - toUid: string
    //   - amountMinor: int (> 0)
    //   - currency: string (3 chars ISO)
    //   - settledAt: timestamp
    //   - createdBy: string (uid)
    //   - notes: optional string (<= 200 chars)
    //
    // Collection: invites/{inviteCode}
    // Fields:
    //   - inviteCode: string
    //   - groupId: string
    //   - groupName: string (1..60 chars)
    //   - defaultCurrency: string (3 chars ISO)
    //   - createdBy: string (uid)
    //   - createdAt: timestamp
    //   - active: bool
    // ===============================================================

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isGroupMember(groupId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/groups/$(groupId)) && (
        ('memberUids' in get(/databases/$(database)/documents/groups/$(groupId)).data &&
         request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids)
        ||
        exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))
      );
    }

    function isGroupCreator(groupId) {
      return isAuthenticated() && (
        request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy
      );
    }

    // Timestamp validation helpers respecting offline persistence
    function isValidCreationTimestamp(ts) {
      return ts is timestamp && ts <= request.time + duration.value(5, 'm');
    }

    function isValidHistoricalDate(ts) {
      return ts is timestamp && ts <= request.time + duration.value(1, 'd');
    }

    function isValidUpdateTimestamp(newTs, oldTs) {
      return newTs is timestamp && newTs >= oldTs && newTs <= request.time + duration.value(5, 'm');
    }

    // User document validation
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'preferredCurrency', 'languageCode', 'createdAt', 'updatedAt']) &&
             data.uid is string && data.uid == request.auth.uid &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 50 &&
             data.preferredCurrency is string && data.preferredCurrency.size() == 3 &&
             data.languageCode is string && data.languageCode.size() >= 2 && data.languageCode.size() <= 5 &&
             isValidCreationTimestamp(data.createdAt) &&
             isValidCreationTimestamp(data.updatedAt);
    }

    // ===============================================================
    // Users Collection
    // ===============================================================
    match /users/{uid} {
      // Direct lookup allowed only for the owning user
      allow get: if isOwner(uid);
      // Listing/enumerating all users is strictly forbidden
      allow list: if false;

      allow create: if isOwner(uid) && isValidUser(request.resource.data);
      allow update: if isOwner(uid) &&
                       isValidUser(request.resource.data) &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       isValidUpdateTimestamp(request.resource.data.updatedAt, resource.data.updatedAt);
      allow delete: if isOwner(uid);

      match /user_groups/{groupId} {
        allow read, write: if isOwner(uid);
      }
    }

    function isValidCurrency(curr) {
      return curr is string && curr.matches('^[A-Z]{3}$');
    }

    function arePayersValid(payers, totalMinor, groupMembers) {
      let s = payers.size();
      let v = payers.values();
      return payers is map && s >= 1 && s <= 5 &&
             groupMembers.hasAll(payers.keys()) &&
             ((s == 1 && v[0] is int && v[0] > 0 && v[0] == totalMinor) ||
              (s == 2 && v[0] is int && v[0] > 0 && v[1] is int && v[1] > 0 && v[0] + v[1] == totalMinor) ||
              (s == 3 && v[0] is int && v[0] > 0 && v[1] is int && v[1] > 0 && v[2] is int && v[2] > 0 && v[0] + v[1] + v[2] == totalMinor) ||
              (s == 4 && v[0] is int && v[0] > 0 && v[1] is int && v[1] > 0 && v[2] is int && v[2] > 0 && v[3] is int && v[3] > 0 && v[0] + v[1] + v[2] + v[3] == totalMinor) ||
              (s == 5 && v[0] is int && v[0] > 0 && v[1] is int && v[1] > 0 && v[2] is int && v[2] > 0 && v[3] is int && v[3] > 0 && v[4] is int && v[4] > 0 && v[0] + v[1] + v[2] + v[3] + v[4] == totalMinor));
    }

    function isValidSplitSum(splits, totalMinor) {
      let s = splits.size();
      let v = splits.values();
      return (s == 1 && v[0] == totalMinor) ||
             (s == 2 && v[0] + v[1] == totalMinor) ||
             (s == 3 && v[0] + v[1] + v[2] == totalMinor) ||
             (s == 4 && v[0] + v[1] + v[2] + v[3] == totalMinor) ||
             (s == 5 && v[0] + v[1] + v[2] + v[3] + v[4] == totalMinor) ||
             (s == 6 && v[0] + v[1] + v[2] + v[3] + v[4] + v[5] == totalMinor) ||
             (s == 7 && v[0] + v[1] + v[2] + v[3] + v[4] + v[5] + v[6] == totalMinor) ||
             (s == 8 && v[0] + v[1] + v[2] + v[3] + v[4] + v[5] + v[6] + v[7] == totalMinor) ||
             (s == 9 && v[0] + v[1] + v[2] + v[3] + v[4] + v[5] + v[6] + v[7] + v[8] == totalMinor) ||
             (s == 10 && v[0] + v[1] + v[2] + v[3] + v[4] + v[5] + v[6] + v[7] + v[8] + v[9] == totalMinor) ||
             (s == 11 && v[0] + v[1] + v[2] + v[3] + v[4] + v[5] + v[6] + v[7] + v[8] + v[9] + v[10] == totalMinor) ||
             (s == 12 && v[0] + v[1] + v[2] + v[3] + v[4] + v[5] + v[6] + v[7] + v[8] + v[9] + v[10] + v[11] == totalMinor) ||
             (s == 13 && v[0] + v[1] + v[2] + v[3] + v[4] + v[5] + v[6] + v[7] + v[8] + v[9] + v[10] + v[11] + v[12] == totalMinor) ||
             (s == 14 && v[0] + v[1] + v[2] + v[3] + v[4] + v[5] + v[6] + v[7] + v[8] + v[9] + v[10] + v[11] + v[12] + v[13] == totalMinor) ||
             (s == 15 && v[0] + v[1] + v[2] + v[3] + v[4] + v[5] + v[6] + v[7] + v[8] + v[9] + v[10] + v[11] + v[12] + v[13] + v[14] == totalMinor) ||
             (s == 16 && v[0] + v[1] + v[2] + v[3] + v[4] + v[5] + v[6] + v[7] + v[8] + v[9] + v[10] + v[11] + v[12] + v[13] + v[14] + v[15] == totalMinor) ||
             (s == 17 && v[0] + v[1] + v[2] + v[3] + v[4] + v[5] + v[6] + v[7] + v[8] + v[9] + v[10] + v[11] + v[12] + v[13] + v[14] + v[15] + v[16] == totalMinor) ||
             (s == 18 && v[0] + v[1] + v[2] + v[3] + v[4] + v[5] + v[6] + v[7] + v[8] + v[9] + v[10] + v[11] + v[12] + v[13] + v[14] + v[15] + v[16] + v[17] == totalMinor) ||
             (s == 19 && v[0] + v[1] + v[2] + v[3] + v[4] + v[5] + v[6] + v[7] + v[8] + v[9] + v[10] + v[11] + v[12] + v[13] + v[14] + v[15] + v[16] + v[17] + v[18] == totalMinor) ||
             (s == 20 && v[0] + v[1] + v[2] + v[3] + v[4] + v[5] + v[6] + v[7] + v[8] + v[9] + v[10] + v[11] + v[12] + v[13] + v[14] + v[15] + v[16] + v[17] + v[18] + v[19] == totalMinor);
    }

    function areSplitsValid(splits, participants, totalMinor, groupMembers) {
      let s = splits.size();
      let v = splits.values();
      return splits is map && s >= 1 && s <= 20 &&
             participants is list && participants.size() == s &&
             v[0] is int && v[0] > 0 &&
             v[s - 1] is int && v[s - 1] > 0 &&
             participants.hasAll(splits.keys()) &&
             splits.keys().hasAll(participants) &&
             groupMembers.hasAll(participants) &&
             groupMembers.hasAll(splits.keys()) &&
             isValidSplitSum(splits, totalMinor);
    }

    function isValidExpense(data, groupId) {
      let group = get(/databases/$(database)/documents/groups/$(groupId));
      let memberUids = 'memberUids' in group.data ? group.data.memberUids : [group.data.createdBy];
      return data.keys().hasAll(['id', 'groupId', 'title', 'category', 'currency', 'totalMinor', 'date', 'splitMethod', 'payers', 'participants', 'splits', 'createdBy', 'createdAt', 'updatedAt']) &&
             data.id is string &&
             data.groupId == groupId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
             data.totalMinor is int && data.totalMinor > 0 &&
             isValidCurrency(data.currency) &&
             isValidCreationTimestamp(data.createdAt) &&
             isValidHistoricalDate(data.date) &&
             request.auth.uid in memberUids &&
             arePayersValid(data.payers, data.totalMinor, memberUids) &&
             areSplitsValid(data.splits, data.participants, data.totalMinor, memberUids);
    }

    // ===============================================================
    // Groups Collection & Subcollections
    // ===============================================================
    match /groups/{groupId} {
      // Listing all groups across the database is forbidden
      allow list: if false;

      // Group details can ONLY be retrieved by active members or the creator.
      // Guessing groupId by non-members is strictly blocked.
      allow get: if isGroupMember(groupId) || (isAuthenticated() && request.auth.uid == resource.data.createdBy);

      // Authenticated users can create groups if they set themselves as creator
      allow create: if isAuthenticated() &&
                       request.resource.data.keys().hasAll(['id', 'name', 'defaultCurrency', 'inviteCode', 'createdBy', 'createdAt', 'updatedAt', 'memberCount', 'memberUids', 'active']) &&
                       request.resource.data.id == groupId &&
                       request.resource.data.createdBy == request.auth.uid &&
                       request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 60 &&
                       request.resource.data.defaultCurrency is string && request.resource.data.defaultCurrency.size() == 3 &&
                       request.resource.data.inviteCode is string && request.resource.data.inviteCode.size() >= 6 && request.resource.data.inviteCode.size() <= 12 &&
                       request.resource.data.memberUids is list &&
                       request.resource.data.memberUids.size() == 1 &&
                       request.resource.data.memberUids[0] == request.auth.uid &&
                       request.resource.data.memberCount == 1 &&
                       request.resource.data.active is bool &&
                       isValidCreationTimestamp(request.resource.data.createdAt) &&
                       isValidCreationTimestamp(request.resource.data.updatedAt);

      // Members can update group details, or joining users can update memberUids and memberCount
      allow update: if isAuthenticated() &&
                       request.resource.data.id == resource.data.id &&
                       request.resource.data.createdBy == resource.data.createdBy &&
                       request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 60 &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       isValidUpdateTimestamp(request.resource.data.updatedAt, resource.data.updatedAt) &&
                       (
                         // Case 1: Existing member updates group metadata (memberUids stays untouched)
                         (isGroupMember(groupId) &&
                          (!('memberUids' in resource.data) || request.resource.data.memberUids == resource.data.memberUids) &&
                          (!('memberCount' in resource.data) || request.resource.data.memberCount == resource.data.memberCount))
                         ||
                         // Case 2: Joining member with valid active invite code adds self only
                         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'memberCount', 'updatedAt']) &&
                          request.resource.data.memberUids is list &&
                          request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1 &&
                          request.resource.data.memberUids.hasAll(resource.data.memberUids) &&
                          request.resource.data.memberUids.hasAll([request.auth.uid]) &&
                          !(request.auth.uid in resource.data.memberUids) &&
                          request.resource.data.memberCount == request.resource.data.memberUids.size() &&
                          exists(/databases/$(database)/documents/invites/$(resource.data.inviteCode)) &&
                          get(/databases/$(database)/documents/invites/$(resource.data.inviteCode)).data.active == true &&
                          get(/databases/$(database)/documents/invites/$(resource.data.inviteCode)).data.groupId == groupId)
                         ||
                         // Case 3: Member self-leaves group (removes self only, creator cannot leave)
                         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'memberCount', 'updatedAt']) &&
                          request.resource.data.memberUids is list &&
                          request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1 &&
                          resource.data.memberUids.hasAll(request.resource.data.memberUids) &&
                          !(request.auth.uid in request.resource.data.memberUids) &&
                          request.auth.uid != resource.data.createdBy &&
                          request.resource.data.memberUids.hasAll([resource.data.createdBy]) &&
                          request.resource.data.memberCount == request.resource.data.memberUids.size())
                         ||
                         // Case 4: Group creator removes a member (creator cannot remove self)
                         (request.auth.uid == resource.data.createdBy &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'memberCount', 'updatedAt']) &&
                          request.resource.data.memberUids is list &&
                          request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1 &&
                          resource.data.memberUids.hasAll(request.resource.data.memberUids) &&
                          request.resource.data.memberUids.hasAll([resource.data.createdBy]) &&
                          request.resource.data.memberCount == request.resource.data.memberUids.size())
                       );

      allow delete: if isAuthenticated() && request.auth.uid == resource.data.createdBy;

      // Subcollection: members
      match /members/{memberUid} {
        // Only active group members can list members (roster)
        allow list: if isGroupMember(groupId);
        // Direct member doc lookup allowed for group members or the member themselves
        allow get: if isGroupMember(groupId) || (isAuthenticated() && request.auth.uid == memberUid);

        // A user can add themselves as a member if creating or joining:
        allow create: if isAuthenticated() && request.auth.uid == memberUid &&
                         request.resource.data.keys().hasAll(['uid', 'displayName', 'role', 'joinedAt']) &&
                         request.resource.data.uid == memberUid &&
                         request.resource.data.displayName is string &&
                         request.resource.data.displayName.size() >= 1 &&
                         request.resource.data.displayName.size() <= 50 &&
                         isValidCreationTimestamp(request.resource.data.joinedAt) &&
                         (
                           // Case 1: Group creator creating group with role 'owner'
                           (request.resource.data.role == 'owner' &&
                            getAfter(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid)
                           ||
                           // Case 2: Joining member with valid active invite code (role strictly 'member')
                           (request.resource.data.role == 'member' &&
                            request.resource.data.keys().hasAll(['inviteCode']) &&
                            request.resource.data.inviteCode is string &&
                            exists(/databases/$(database)/documents/groups/$(groupId)) &&
                            get(/databases/$(database)/documents/groups/$(groupId)).data.active == true &&
                            get(/databases/$(database)/documents/groups/$(groupId)).data.inviteCode == request.resource.data.inviteCode &&
                            exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)) &&
                            get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.active == true &&
                            get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.groupId == groupId)
                         );

        // Users can update their own display name within the group
        allow update: if isAuthenticated() && request.auth.uid == memberUid &&
                         request.resource.data.uid == memberUid &&
                         request.resource.data.role == resource.data.role &&
                         request.resource.data.joinedAt == resource.data.joinedAt &&
                         request.resource.data.displayName is string && request.resource.data.displayName.size() >= 1 && request.resource.data.displayName.size() <= 50;

        // User can remove themselves or group creator can remove member
        allow delete: if isAuthenticated() && (request.auth.uid == memberUid || isGroupCreator(groupId));
      }

      // Subcollection: expenses
      match /expenses/{expenseId} {
        // ONLY group members can read or list expenses
        allow get, list: if isGroupMember(groupId);

        // ONLY group members can create expenses in their group
        allow create: if isGroupMember(groupId) &&
                         request.resource.data.id == expenseId &&
                         request.resource.data.createdBy == request.auth.uid &&
                         isValidExpense(request.resource.data, groupId) &&
                         isValidCreationTimestamp(request.resource.data.updatedAt);

        // ONLY group members can update expenses in their group
        allow update: if isGroupMember(groupId) &&
                         request.resource.data.id == resource.data.id &&
                         request.resource.data.groupId == resource.data.groupId &&
                         request.resource.data.createdBy == resource.data.createdBy &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         isValidUpdateTimestamp(request.resource.data.updatedAt, resource.data.updatedAt) &&
                         isValidExpense(request.resource.data, groupId);

        // ONLY group members can delete expenses in their group
        allow delete: if isGroupMember(groupId);
      }

      // Subcollection: settlements
      match /settlements/{settlementId} {
        // ONLY group members can read or list settlements
        allow get, list: if isGroupMember(groupId);

        // ONLY group members can record settlements between members of their group
        allow create: if isGroupMember(groupId) &&
                         request.resource.data.keys().hasAll(['id', 'groupId', 'fromUid', 'toUid', 'amountMinor', 'currency', 'settledAt', 'createdBy']) &&
                         request.resource.data.id == settlementId &&
                         request.resource.data.groupId == groupId &&
                         request.resource.data.createdBy == request.auth.uid &&
                         request.resource.data.fromUid is string &&
                         request.resource.data.toUid is string &&
                         request.resource.data.fromUid != request.resource.data.toUid &&
                         exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.resource.data.fromUid)) &&
                         exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.resource.data.toUid)) &&
                         request.resource.data.amountMinor is int && request.resource.data.amountMinor > 0 &&
                         isValidCurrency(request.resource.data.currency) &&
                         isValidCreationTimestamp(request.resource.data.settledAt);

        // Completed financial settlements are strictly immutable
        allow update: if false;

        // Group members can delete/revert settlements
        allow delete: if isGroupMember(groupId);
      }
    }

    // ===============================================================
    // Public Invites Collection
    // ===============================================================
    match /invites/{inviteCode} {
      // Direct lookup ONLY for authenticated users with the specific code
      allow get: if isAuthenticated();

      // Collection listing / enumeration strictly forbidden
      allow list: if false;

      // Only group members or creator can publish an invite
      allow create: if isAuthenticated() &&
                       request.resource.data.keys().hasAll(['inviteCode', 'groupId', 'groupName', 'defaultCurrency', 'createdBy', 'createdAt', 'active']) &&
                       request.resource.data.inviteCode == inviteCode &&
                       request.resource.data.createdBy == request.auth.uid &&
                       request.resource.data.active is bool &&
                       isValidCreationTimestamp(request.resource.data.createdAt);

      allow update: if isAuthenticated() &&
                       isGroupMember(resource.data.groupId) &&
                       request.resource.data.groupId == resource.data.groupId &&
                       request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isAuthenticated() && isGroupCreator(resource.data.groupId);
    }
  }
}
