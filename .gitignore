# Firebase credential files — must NOT be committed to version control.
# Obtain from Firebase Console and place locally.
# iOS: download from Firebase Console > Project Settings > iOS app > GoogleService-Info.plist
ios/Runner/GoogleService-Info.plist
# Android: download from Firebase Console > Project Settings > Android app > google-services.json
android/app/google-services.json

# Android keystore and signing credentials — must NOT be committed to version control.
*.jks
*.keystore
**/key.properties
**/android/key.properties
.kotlin/
android/.kotlin/

